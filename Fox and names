#include <bits/stdc++.h>
using namespace std;

vector<int> graph[26];
int vis[26]; // 0 = unvisited, 1 = visiting, 2 = visited
string ans;

bool dfs(int u) {
    vis[u] = 1;

    for (int v : graph[u]) {
        if (vis[v] == 1)
            return false; // cycle
        if (vis[v] == 0) {
            if (!dfs(v))
                return false;
        }
    }

    vis[u] = 2;
    ans.push_back(char(u + 'a'));
    return true;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin >> n;

    vector<string> words(n);
    for (int i = 0; i < n; i++)
        cin >> words[i];

    for (int i = 0; i < n - 1; i++) {
        string a = words[i];
        string b = words[i + 1];

        int len = min(a.size(), b.size());
        bool found = false;

        for (int j = 0; j < len; j++) {
            if (a[j] != b[j]) {
                graph[a[j] - 'a'].push_back(b[j] - 'a');
                found = true;
                break;
            }
        }

        if (!found && a.size() > b.size()) {
            cout << "Impossible\n";
            return 0;
        }
    }

    for (int i = 0; i < 26; i++) {
        if (vis[i] == 0) {
            if (!dfs(i)) {
                cout << "Impossible\n";
                return 0;
            }
        }
    }

    reverse(ans.begin(), ans.end());
    cout << ans << "\n";

    return 0;
}
