#include <bits/stdc++.h>
using namespace std;

const int N = 100005;

vector<int> graph[N];

double dfs(int u, int parent) {
    int children = 0;
    double sum = 0;

    for (int v : graph[u]) {
        if (v != parent) {
            children++;
            sum += dfs(v, u);
        }
    }

    if (children == 0)
        return 0.0;

    return 1.0 + sum / children;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin >> n;

    for (int i = 0; i < n - 1; i++) {
        int u, v;
        cin >> u >> v;
        graph[u].push_back(v);
        graph[v].push_back(u);
    }

    cout << fixed << setprecision(10) << dfs(1, 0) << '\n';

    return 0;
}
